+    private static int statConfirmedShadowRawForSpanLocked(long startMs, long endMs) {
+        if (endMs <= startMs || timelineCount <= 0) return -1;
+        long span = endMs - startMs;
+        long[] byRaw = new long[MAX_PROFILES];
+        for (int i = 0; i < timelineCount; i++) {
+            int raw = TL_SPEAKER[i];
+            if (raw < 0 || raw >= profileCount) continue;
+            int human = humanForProfileLocked(raw);
+            if (human < 0 || human >= humanCount || !HUMAN_ACTIVE[human] || !HUMAN_CONFIRMED[human]) continue;
+            long overlap = Math.min(endMs, TL_END[i]) - Math.max(startMs, TL_START[i]);
+            if (overlap > 0L) byRaw[raw] += overlap;
+        }
+        int best = -1;
+        long bestMs = 0L;
+        long secondMs = 0L;
+        for (int raw = 0; raw < profileCount; raw++) {
+            long ms = byRaw[raw];
+            if (ms > bestMs) { secondMs = bestMs; bestMs = ms; best = raw; }
+            else if (ms > secondMs) secondMs = ms;
+        }
+        if (best < 0 || bestMs * 1000L < span * 650L) return -1;
+        // A close tie means the shadow path itself observed a transition; do not erase it.
+        if (secondMs > 0L && bestMs < secondMs * 2L) return -1;
+        return best;
+    }
