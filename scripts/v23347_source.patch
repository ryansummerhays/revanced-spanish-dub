+    private static int statConfirmedShadowRawForModeLocked(int modeId) {
+        if (modeId < 0 || modeId >= statModeCount) return -1;
+        StatMode mode = STAT_MODES[modeId];
+        if (mode == null || mode.count <= 0) return -1;
+        int raw = -1;
+        int observed = 0;
+        for (int i = 0; i < mode.count; i++) {
+            int episodeId = mode.episodeIds[i];
+            if (episodeId < 0 || episodeId >= statEpisodeCount) continue;
+            StatEpisode ep = STAT_EPISODES[episodeId];
+            if (ep == null) continue;
+            int r = statConfirmedShadowRawForSpanLocked(ep.startMs, ep.endMs);
+            if (r < 0) continue;
+            if (raw >= 0 && raw != r) return -1;
+            raw = r;
+            observed++;
+        }
+        return observed > 0 ? raw : -1;
+    }
